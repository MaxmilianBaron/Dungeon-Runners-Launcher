<Window x:Class="DungeonRunners.Launcher.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dungeon Runners · Reborn" Icon="/Assets/DungeonRunners.ico" Width="960" Height="800" MinWidth="320" MinHeight="240" WindowStartupLocation="CenterScreen" Background="#100E0C" Foreground="#EFE6CF" FontFamily="{StaticResource GameFont}" FontSize="16" Opened="OnLoaded" Closing="OnClosing" UseLayoutRounding="True">
  <Grid>
  <Border BorderBrush="{StaticResource GoldFrame}" BorderThickness="4" Padding="5">
    <Border BorderBrush="#57422D" BorderThickness="1">
      <Border.Background><ImageBrush Source="avares://DungeonRunnersLauncher/Assets/AdBackground.png" Stretch="Fill" /></Border.Background>
      <Grid Margin="8,0" ColumnDefinitions="11*,78*,11*">
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" Margin="0,8,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ContentGrid" MinHeight="{Binding Bounds.Height, ElementName=PageScroll}" RowDefinitions="Auto,*,Auto,Auto,Auto">
          <Grid x:Name="Header" ColumnDefinitions="150,*,150" RowDefinitions="78">
            <StackPanel x:Name="WebsiteLinks" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="6">
              <StackPanel Orientation="Horizontal">
              <Button x:Name="Website" Content="Website" Click="WebsiteClick" FontSize="12" MinHeight="28" Padding="6,2" />
              <Button x:Name="Armory" Content="Armory" Click="ArmoryClick" FontSize="12" MinHeight="28" Padding="6,2" Margin="6,0,0,0" />
              </StackPanel>
              <Button x:Name="Leaderboard" Content="Leaderboard" Click="LeaderboardClick" HorizontalAlignment="Left" FontSize="12" MinHeight="28" Padding="6,2" />
            </StackPanel>
            <Image x:Name="Logo" Grid.Column="1" Source="avares://DungeonRunnersLauncher/Assets/AdFrame_DRLogo.png" MaxWidth="312" Height="78" Stretch="Uniform" Margin="8,0" />
            <StackPanel x:Name="SupportLinks" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
              <Button x:Name="Discord" Content="Discord" Click="DiscordClick" HorizontalAlignment="Right" FontSize="12" MinHeight="28" Padding="8,2" />
              <Button x:Name="DesyncReport" Content="Desync Report" Click="DesyncReportClick" HorizontalAlignment="Right" FontSize="12" MinHeight="28" Padding="8,2" ToolTip.Tip="Report a desync on the Reborn website using your game account" />
            </StackPanel>
          </Grid>
          <Border x:Name="ArtworkFrame" Grid.Row="1" BorderBrush="{StaticResource GoldFrame}" BorderThickness="2" Background="Black" Margin="0,6,0,12" ClipToBounds="True">
            <Grid x:Name="ArtworkHost" ClipToBounds="True" MinHeight="240">
              <Rectangle x:Name="ArtworkRear"><Rectangle.Fill><ImageBrush SourceRect="0%,21.875%,100%,53.515625%" Stretch="Uniform" /></Rectangle.Fill></Rectangle>
              <Rectangle x:Name="ArtworkFront"><Rectangle.Fill><ImageBrush SourceRect="0%,21.875%,100%,53.515625%" Stretch="Uniform" /></Rectangle.Fill></Rectangle>
              <Canvas>
              <Border x:Name="AddonsPanel" IsVisible="False" Background="#F5110F0C" Padding="16,12" Width="{Binding Bounds.Width, ElementName=ArtworkHost}" Height="{Binding Bounds.Height, ElementName=ArtworkHost}">
                <Border.Styles><Style Selector="ScrollBar:vertical"><Setter Property="Width" Value="16" /><Setter Property="MinWidth" Value="16" /><Setter Property="MaxWidth" Value="16" /><Setter Property="Margin" Value="0" /></Style></Border.Styles>
                <Grid RowDefinitions="Auto,*,Auto">
                  <Grid x:Name="AddonHeader" ColumnDefinitions="*,90" Margin="0,0,28,0"><TextBlock x:Name="AddonTitle" Text="Dungeon Runners Addons" FontSize="17" Foreground="{StaticResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" /><Button x:Name="CloseAddons" Grid.Column="1" Content="Close" Click="CloseAddonsClick" Width="90" FontSize="12" MinHeight="30" Padding="8,2" /></Grid>
                  <ScrollViewer x:Name="AddonScroll" Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                  <StackPanel Spacing="6" Margin="0,0,12,0">
                    <TextBlock Text="Settings and history are kept. In game: ESC → Addons." TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="AddonNotice" Text="Close Dungeon Runners to manage addons." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" IsVisible="False" />
                    <Border Height="1" Background="#57422D" Margin="0,3,0,0" />
                    <StackPanel x:Name="AddonList" Spacing="0" />
                  </StackPanel>
                  </ScrollViewer>
                  <WrapPanel Grid.Row="2" Margin="0,0,28,0">
                    <Button x:Name="InstallAddons" Content="Install all" Click="InstallAddonsClick" FontSize="12" MinHeight="26" Padding="8,2" Margin="0,4,8,0" />
                    <Button x:Name="UninstallAddons" Content="Uninstall all" Click="UninstallAddonsClick" FontSize="12" MinHeight="26" Padding="8,2" Margin="0,4,0,0" IsVisible="False" ToolTip.Tip="Remove the addon runtime and keep settings and history" />
                  </WrapPanel>
                </Grid>
              </Border>
              </Canvas>
            </Grid>
          </Border>
          <StackPanel x:Name="InstallationPanel" Grid.Row="2">
            <WrapPanel Margin="0,0,0,7"><TextBlock Text="Installation folder" Foreground="{StaticResource Accent}" FontSize="16" Margin="0,0,16,0" /><TextBlock x:Name="VersionLabel" Text="Client 666 · Release 1.0.1" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" /></WrapPanel>
            <Grid ColumnDefinitions="*,Auto"><TextBox x:Name="Folder" AutomationProperties.Name="Installation folder" TextChanged="FolderChanged" Padding="8,5" /><Button x:Name="Browse" Grid.Column="1" Content="Browse" Margin="10,0,0,0" Click="BrowseClick" FontSize="12" MinHeight="30" Padding="10,2" /></Grid>
            <CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" IsChecked="True" Margin="0,7,0,8" />
          </StackPanel>
          <Border x:Name="StatusPanel" Grid.Row="3" Background="#CA090806" BorderBrush="#56422C" BorderThickness="1" Padding="12,7" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <DockPanel><Button x:Name="Cancel" Content="Cancel" DockPanel.Dock="Right" Click="CancelClick" IsVisible="False" Padding="9,1" MinHeight="24" FontSize="12" Margin="12,0,0,0" /><Button x:Name="OpenGameLog" Content="Open log" DockPanel.Dock="Right" Click="OpenGameLogClick" IsVisible="False" Padding="9,1" MinHeight="24" FontSize="12" Margin="12,0,0,0" /><TextBlock x:Name="Status" Text="Checking for updates" FontSize="17" Foreground="{StaticResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
              <TextBlock x:Name="Detail" Grid.Row="1" Text="Connecting to the release service…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" FontSize="14" MaxHeight="44" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <DockPanel x:Name="TransferRow" Grid.Row="2" IsVisible="False" Margin="0,5,0,0"><TextBlock x:Name="Transfer" DockPanel.Dock="Right" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0,0,0" /><ProgressBar x:Name="Progress" Height="5" Foreground="{StaticResource Accent}" Background="#302619" BorderThickness="0" Minimum="0" Maximum="100" IsVisible="False" VerticalAlignment="Center" /></DockPanel>
            </Grid>
          </Border>
          <WrapPanel x:Name="Actions" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="Primary" Content="Install game" Click="PrimaryClick" FontSize="14" MinWidth="124" MinHeight="34" Padding="10,2" Margin="0,3,10,3" /><Button x:Name="Update" Content="Update" Click="UpdateClick" FontSize="14" MinWidth="104" MinHeight="34" Padding="10,2" Margin="0,3,10,3" /><Button x:Name="Addons" Content="Addons" Click="AddonsClick" FontSize="14" MinWidth="104" MinHeight="34" Padding="10,2" Margin="0,3,18,3" /><Button x:Name="Repair" Content="Repair" Click="RepairClick" VerticalAlignment="Center" FontSize="12" MinHeight="28" Padding="8,2" Margin="0,3" ToolTip.Tip="Verify and restore game files" /></WrapPanel>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
    <Border x:Name="ConflictPanel" IsVisible="False" Background="#F5110F0C" BorderBrush="{StaticResource GoldFrame}" BorderThickness="2" Margin="16" Padding="14" MaxWidth="520" VerticalAlignment="Center" MaxHeight="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Window}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <TextBlock Text="Client conflict" FontSize="22" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
          <TextBlock x:Name="ConflictDetail" FontSize="15" TextWrapping="Wrap" />
          <WrapPanel>
            <Button x:Name="KeepChanges" Content="Keep my changes" Click="KeepChangesClick" FontSize="13" Padding="8,4" Margin="0,0,8,8" />
            <Button x:Name="RestoreRequired" Content="Restore required parts" Click="RestoreRequiredClick" FontSize="13" Padding="8,4" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
